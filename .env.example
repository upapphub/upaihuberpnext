# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env

ERPNEXT_VERSION=v16.32.3
SITE_NAME=frontend
FRAPPE_SITE_NAME_HEADER=frontend

# Must match the existing MariaDB volume unless you rotate the DB user.
MYSQL_ROOT_PASSWORD=admin

# Used on first site create and by scripts/set-admin-password.sh
ADMIN_PASSWORD=changeme
